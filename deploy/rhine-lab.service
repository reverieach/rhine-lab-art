[Unit]
Description=Rhine Lab art archive
After=network.target

[Service]
Type=simple
User=rhine-lab
Group=rhine-lab
WorkingDirectory=/opt/rhine-lab
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4199
ExecStart=/usr/local/bin/node /opt/rhine-lab/scripts/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
